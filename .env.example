# PostgreSQL (matches docker-compose.yml — host port 5544 to avoid conflicts)
DATABASE_URL="postgresql://pleos:pleos@localhost:5544/pleos?schema=public"

# Auth.js — generate a secret with: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-please-generate-a-real-one"
# NextAuth v5 reads AUTH_SECRET; keep NEXTAUTH_URL for local clarity.
NEXTAUTH_URL="http://localhost:3000"

# Store-scoped API key used by the external customer/order app to push orders
# into POST /api/ingest/orders (x-store-key header). Change for real deployments.
INGEST_API_KEY="pleos-dev-ingest-key"

# Public base URL exposed to the browser (SSE endpoint etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
