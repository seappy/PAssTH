# PostgreSQL — two connection strings.
#   DATABASE_URL = app runtime connection.
#   DIRECT_URL   = direct/session connection for Prisma migrations AND the
#                  realtime LISTEN/NOTIFY (src/server/events.ts).
#
# Local (docker-compose, host port 5544): both are the same.
DATABASE_URL="postgresql://pleos:pleos@localhost:5544/pleos?schema=public"
DIRECT_URL="postgresql://pleos:pleos@localhost:5544/pleos?schema=public"
#
# Supabase (top bar → Connect, or Settings → Database → Connection string):
#   DATABASE_URL = "Transaction pooler" (6543) + "?pgbouncer=true&connection_limit=1"
#   DIRECT_URL   = "Session pooler"     (5432)   ← use this, NOT "Direct connection"
# The "Direct connection" (db.<ref>.supabase.co:5432) is IPv6-only on the free
# tier and often unreachable; the Session pooler is IPv4 and supports LISTEN/
# NOTIFY. The pooled DATABASE_URL cannot do LISTEN/NOTIFY (that's why events.ts
# uses DIRECT_URL). Never commit real credentials — keep them in .env / the host.
# URL-encode special chars in the password (! -> %21, * -> %2A, + -> %2B, etc.).

# Auth.js — generate a secret with: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-please-generate-a-real-one"
# NextAuth v5 reads AUTH_SECRET; keep NEXTAUTH_URL for local clarity.
NEXTAUTH_URL="http://localhost:3000"

# Store-scoped API key used by the external customer/order app to push orders
# into POST /api/ingest/orders (x-store-key header). Change for real deployments.
INGEST_API_KEY="pleos-dev-ingest-key"

# Public base URL exposed to the browser (SSE endpoint etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Kakao Maps JavaScript key for the live map. Leave empty to use the mock map.
# Get one at https://developers.kakao.com (JavaScript key) and register
# http://localhost:3000 under Platform → Web.
NEXT_PUBLIC_KAKAO_MAP_KEY=""
